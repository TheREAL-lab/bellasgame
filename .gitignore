# Godot 4+ specific ignores
.godot/
.import/
export.cfg

# export_presets.cfg IS tracked -- it holds no credentials and makes the
# desktop build reproducible. Keep signing secrets out of it.

# Built app bundles
build/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/editor files
.DS_Store
Thumbs.db
